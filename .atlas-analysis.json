  "keyFeatures": [
    "One-time payment processing with automatic or manual capture",
    "Customer management with merchant-scoped visibility",
    "Tokenized payment instruments (cards and bank accounts)",
    "Product and price catalog with one-time and recurring pricing",
    "Full merchant onboarding and KYB application flow",
    "Cursor-based pagination for all list endpoints",
    "Idempotency keys for safe request retries",
    "Multi-currency support (USD, CAD)"
  ],
  "publicApiSurface": [
    "POST /payments",
    "GET /payments",
    "POST /customers",
    "GET /customers/{id}",
    "POST /merchants/{merchantId}/customers",
    "GET /merchants/{merchantId}/customers",
    "POST /payment-instruments",
    "GET /tokenization/cards/{tokenId}/display",
    "GET /tokenization/bank-accounts/{tokenId}/display",
    "POST /catalog/products",
    "GET /catalog/products/{productId}",
    "POST /catalog/prices",
    "PUT /catalog/prices/{priceId}/archive",
    "POST /merchant-applications",
    "GET /merchant-applications/{id}",
    "PATCH /merchant-applications/{id}/business-profile",
    "PATCH /merchant-applications/{id}/beneficial-owners",
    "PATCH /merchant-applications/{id}/payout-accounts",
    "PATCH /merchant-applications/{id}/underwriting",
    "POST /merchant-applications/{id}/submit",
    "GET /merchants/dashboard/home/summary-metrics"
  ]
}
